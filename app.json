{
  "expo": {
    "name": "Qubi",
    "slug": "qubi-mobile",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/Qubi.jpg",
    "userInterfaceStyle": "automatic",
    "scheme": "qubi",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.qubi.app",
      "buildNumber": "15",
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.security.application-groups": ["group.com.qubi.app"]
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Qubi needs camera access so you can snap photo proof of your daily tasks and habits.",
        "NSPhotoLibraryUsageDescription": "Qubi needs access to your photo library to select proof images for completed habits.",
        "NSMicrophoneUsageDescription": "Qubi does not record audio.",
        "NSHealthShareUsageDescription": "Qubi reads your step count, workouts, and health data from Apple Health to automatically calculate dynamic XP and verify fitness tasks.",
        "NSHealthUpdateUsageDescription": "Qubi syncs habit achievements and activity logs back to Apple Health.",
        "NSCalendarsUsageDescription": "Qubi accesses your calendar to find free time for quests and sync scheduled tasks.",
        "NSRemindersUsageDescription": "Qubi creates reminders for your quests so you never miss a scheduled task.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.qubi.app",
      "adaptiveIcon": {
        "backgroundColor": "#EE6C13",
        "foregroundImage": "./assets/Qubi.jpg",
        "backgroundImage": "./assets/adaptive-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "READ_CALENDAR",
        "WRITE_CALENDAR",
        "SCHEDULE_EXACT_ALARM",
        "POST_NOTIFICATIONS",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#58CC02",
          "image": "./assets/splash-icon.png",
          "imageWidth": 256,
          "resizeMode": "cover"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#F97316"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-video",
      "expo-calendar",
      "expo-secure-store",
      "expo-audio",
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.qubi.app",
          "widgets": [
            {
              "name": "QubiWidget",
              "displayName": "Qubi Streak",
              "description": "Your streak, XP level and Qubi's daily status at a glance.",
              "supportedFamilies": ["systemSmall", "systemMedium"]
            }
          ]
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "540cd887-a3dd-413a-b74f-f8ddbbdeb7a7"
      },
      "EXPO_PUBLIC_SUPABASE_URL": "https://qnbrrxwctokuwxglcdjd.supabase.co",
      "EXPO_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_qTECh9PHTWpUUUVZeSjoCw_k9vzYCaj",
      "EXPO_PUBLIC_OPENROUTER_API_KEY": "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",
      "EXPO_PUBLIC_OPENROUTER_VISION_MODEL": "google/gemma-4-26b-a4b-it:free"
    },
    "owner": "yonathan-tech"
  }
}
